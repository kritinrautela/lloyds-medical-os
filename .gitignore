# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Local
.env
.env.local
.DS_Store

# Temporary & Cache
.cache/
.parcel-cache/
.temp/
.tempmediaStorage/
tests/output/
.playwright-mcp/
*.backup

# The clinic's own certificate and private key. Made on the clinic computer by
# server/scripts/make-certificate.js. A key that shipped with the software
# would be a key everybody has, so it never enters the repository.
server/certs/

# Demo raw video and intermediate audio
demo-videos/**/*.webm
demo-videos/*.webm
demo-videos/**/*.aiff
demo-videos/*.aiff


# Patient photographs are clinical records, never source. They stay on the clinic machine.
server/data/patient_photos/

# Screenshots taken at the repository root during testing
/*.png

# Vite build manifest, regenerated on every build
client/dist/.vite/

# Set at installation, never committed: the company Google client and head office key
server/config/install.json

# Where the last USB and head office copies went
server/data/offsite-state.json

# Portable Node.js the launchers download on first run (100+ MB, per computer)
runtime/

# The clinic's live database holds patient records: never in the repository.
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm
server/data/*.db.enc
